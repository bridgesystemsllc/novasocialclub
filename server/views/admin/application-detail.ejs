<%
  var statusClass = '';
  var statusDisplay = a.status;
  if (a.status === 'pending') statusClass = 'badge-warning';
  else if (a.status === 'waitlisted') statusClass = 'badge-info';
  else if (a.status === 'follow_up') { statusClass = 'badge-secondary'; statusDisplay = 'follow-up'; }
  else if (a.status === 'accepted') statusClass = 'badge-success';
  else if (a.status === 'rejected') statusClass = 'badge-danger';
%>
<div class="page-header">
  <div>
    <p class="text-muted mb-0" style="margin-bottom:4px"><a href="/admin/applications">← All applications</a></p>
    <h1 class="mt-0"><%= a.first_name %> <%= a.last_name %> <span class="badge <%= statusClass %>"><%= statusDisplay %></span></h1>
  </div>
</div>

<% if (typeof stripeMsg !== 'undefined' && stripeMsg) { %>
<div class="alert <%= stripeMsg.type === 'success' ? 'alert-success' : 'alert-warning' %>">
  <%= stripeMsg.text %>
</div>
<% } %>
<div class="card">
  <h3>Application answers</h3>
  <p><b>Email</b><br><%= a.email || '—' %></p>
  <p><b>Cellphone Number</b><br><%= a.phone || '—' %></p>
  <p><b>Company</b><br><%= a.company || '—' %></p>
  <p><b>LinkedIn</b><br><%= a.linkedin || '—' %></p>
  <p><b>What do you do?</b><br><%= a.profession || '—' %></p>
  <p><b>Age</b><br><%= a.age || '—' %></p>
  <p><b>Do you live in Virginia?</b><br><%= a.live_va || '—' %></p>
  <p><b>Do you work in Virginia?</b><br><%= a.work_va || '—' %></p>
  <p><b>Industry</b><br><%= a.industry || '—' %></p>
  <p><b>Occupation</b><br><%= a.occupation || '—' %></p>
  <p><b>Why do you want to join the NOVA Social Club?</b><br><%= a.why || '—' %></p>
  <p><b>What are you looking to get out of membership?</b><br><%= a.goals || '—' %></p>
<% if (a.area) { %>
  <p><b>Area (legacy)</b><br><%= a.area %></p>
<% } %>
</div>
<% if (['pending', 'waitlisted', 'follow_up'].includes(a.status)) { %>
<div class="card">
  <h3>Accept</h3>
  <form method="post" action="/admin/applications/<%= a.id %>/accept" class="actions">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="levelId"><% levels.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }); %></select>
    <button class="btn-primary">Accept &amp; create login</button>
  </form>
  <h3>Reject</h3>
  <form method="post" action="/admin/applications/<%= a.id %>/reject" class="actions" onsubmit="return confirm('Reject this application?');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label style="display:flex;gap:6px;align-items:center;margin:0"><input type="checkbox" name="notify" style="width:auto"> Email applicant</label>
    <button>Reject</button>
  </form>
  <h3>Other actions</h3>
  <div class="actions">
    <form method="post" action="/admin/applications/<%= a.id %>/waitlist" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="<%= a.status === 'waitlisted' ? 'btn-primary' : '' %>">Waitlist</button>
    </form>
    <form method="post" action="/admin/applications/<%= a.id %>/follow-up" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="<%= a.status === 'follow_up' ? 'btn-primary' : '' %>">Follow-up</button>
    </form>
  </div>
</div>
<% } %>
<div class="card">
  <h3>Private notes</h3>
  <form method="post" action="/admin/applications/<%= a.id %>/notes">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <textarea name="notes" rows="4"><%= a.admin_notes || '' %></textarea>
    <button class="btn-primary">Save notes</button>
  </form>
</div>
