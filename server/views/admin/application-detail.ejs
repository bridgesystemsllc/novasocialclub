<%
  var statusClass = '';
  var statusDisplay = a.status;
  if (a.status === 'pending') statusClass = 'badge-warning';
  else if (a.status === 'waitlisted') statusClass = 'badge-info';
  else if (a.status === 'follow_up') { statusClass = 'badge-secondary'; statusDisplay = 'follow-up'; }
  else if (a.status === 'accepted') statusClass = 'badge-success';
  else if (a.status === 'rejected') statusClass = 'badge-danger';
%>
<div class="page-header">
  <div>
    <p class="text-muted mb-0" style="margin-bottom:4px"><a href="/admin/applications">← All applications</a></p>
    <h1 class="mt-0"><%= a.first_name %> <%= a.last_name %> <span class="badge <%= statusClass %>"><%= statusDisplay %></span></h1>
  </div>
</div>

<% if (typeof stripeMsg !== 'undefined' && stripeMsg) { %>
<div class="alert <%= stripeMsg.type === 'success' ? 'alert-success' : 'alert-warning' %>">
  <%= stripeMsg.text %>
</div>
<% } %>
<div class="card">
  <p><b>Email:</b> <%= a.email %> &nbsp; <b>Phone:</b> <%= a.phone || '—' %></p>
  <p><b>Company:</b> <%= a.company || '—' %> &nbsp; <b>Profession:</b> <%= a.profession || '—' %></p>
  <p><b>LinkedIn:</b> <%= a.linkedin || '—' %> &nbsp; <b>Area:</b> <%= a.area || '—' %></p>
  <p><b>Why join:</b><br><%= a.why || '—' %></p>
</div>
<% if (['pending', 'waitlisted', 'follow_up'].includes(a.status)) { %>
<div class="card">
  <h3>Accept</h3>
  <form method="post" action="/admin/applications/<%= a.id %>/accept" class="actions">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="levelId"><% levels.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }); %></select>
    <button class="btn-primary">Accept &amp; create login</button>
  </form>
  <h3>Reject</h3>
  <form method="post" action="/admin/applications/<%= a.id %>/reject" class="actions" onsubmit="return confirm('Reject this application?');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label style="display:flex;gap:6px;align-items:center;margin:0"><input type="checkbox" name="notify" style="width:auto"> Email applicant</label>
    <button>Reject</button>
  </form>
  <h3>Other actions</h3>
  <div class="actions">
    <form method="post" action="/admin/applications/<%= a.id %>/waitlist" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="<%= a.status === 'waitlisted' ? 'btn-primary' : '' %>">Waitlist</button>
    </form>
    <form method="post" action="/admin/applications/<%= a.id %>/follow-up" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="<%= a.status === 'follow_up' ? 'btn-primary' : '' %>">Follow-up</button>
    </form>
  </div>
</div>
<% } %>
<% if (a.status === 'accepted') { %>
<div class="card">
  <h3>Member onboarding</h3>
  <% if (member) { %>
    <p>
      <b>Member:</b> <%= member.first_name %> <%= member.last_name %>
      <a href="/admin/members/<%= member.id %>" class="btn" style="margin-left:12px">Open member</a>
    </p>
    <p>
      <b>Login:</b> <span class="badge <%= member.password_hash ? 'badge-success' : 'badge-warning' %>"><%= member.password_hash ? 'active' : 'not set yet' %></span>
      &nbsp;
      <b>Stripe:</b> <span class="mono"><%= member.stripe_customer_id || '—' %></span>
      &nbsp;
      <b>Sub:</b> <span class="badge <%= hasActiveSub ? 'badge-success' : 'badge-muted' %>"><%= subscription ? subscription.status : 'none' %></span>
    </p>
    <div class="actions" style="margin-top:12px">
      <form method="post" action="/admin/applications/<%= a.id %>/resend-onboarding" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Resend onboarding email</button>
      </form>
      <% if (!hasActiveSub) { %>
      <form method="post" action="/admin/applications/<%= a.id %>/email-payment-link" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-primary">Email payment link</button>
      </form>
      <% } %>
    </div>
    <% if (!member.stripe_customer_id) { %>
    <div class="actions" style="margin-top:8px">
      <form method="post" action="/admin/applications/<%= a.id %>/sync-stripe-customer" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Sync Stripe Customer</button>
      </form>
    </div>
    <% } %>
  <% } else { %>
    <div class="alert alert-warning">
      No member record linked. Create was expected on Accept — contact eng / re-run Accept path.
    </div>
  <% } %>
</div>
<% } %>
<div class="card">
  <h3>Private notes</h3>
  <form method="post" action="/admin/applications/<%= a.id %>/notes">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <textarea name="notes" rows="4"><%= a.admin_notes || '' %></textarea>
    <button class="btn-primary">Save notes</button>
  </form>
</div>
