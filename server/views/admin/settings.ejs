<div class="page-header">
  <div>
    <h1>Settings</h1>
    <p class="subtitle">Read-only configuration health check</p>
  </div>
</div>

<div class="health-grid">
  <div class="health-tile">
    <h3><span class="tile-icon">💳</span> Stripe</h3>
    <div class="health-row">
      <span class="label">API Keys</span>
      <span class="value">
        <% if (stripeKeysConfigured) { %>
        <span class="badge badge-success"><%= stripeMode %> ✓</span>
        <% } else { %>
        <span class="badge badge-danger">Not set</span>
        <% } %>
      </span>
    </div>
    <div class="health-row">
      <span class="label">Price ID</span>
      <span class="value">
        <% if (stripePriceConfigured) { %>
        <span class="badge badge-success">Set ✓</span>
        <% } else { %>
        <span class="badge badge-warning">Not set</span>
        <% } %>
      </span>
    </div>
    <div class="health-row">
      <span class="label">Webhook Secret</span>
      <span class="value">
        <% if (webhookSecretConfigured) { %>
        <span class="badge badge-success">Set ✓</span>
        <% } else { %>
        <span class="badge badge-warning">Not set</span>
        <% } %>
      </span>
    </div>
  </div>

  <div class="health-tile">
    <h3><span class="tile-icon">📧</span> Email</h3>
    <div class="health-row">
      <span class="label">Resend API</span>
      <span class="value">
        <% if (resendConfigured) { %>
        <span class="badge badge-success">Configured ✓</span>
        <% } else { %>
        <span class="badge badge-warning">Not set</span>
        <% } %>
      </span>
    </div>
    <div class="health-row">
      <span class="label">From Address</span>
      <span class="value">
        <% if (resendFrom) { %>
        <span class="mono" style="font-size:12px"><%= resendFrom %></span>
        <% } else { %>
        <span class="badge badge-muted">Default</span>
        <% } %>
      </span>
    </div>
  </div>

  <div class="health-tile">
    <h3><span class="tile-icon">⚙️</span> Application</h3>
    <div class="health-row">
      <span class="label">Base URL</span>
      <span class="value mono" style="font-size:12px"><%= appBaseUrl || '—' %></span>
    </div>
    <div class="health-row">
      <span class="label">Environment</span>
      <span class="value">
        <span class="badge <%= isProd ? 'badge-warning' : 'badge-muted' %>"><%= isProd ? 'Production' : 'Development' %></span>
      </span>
    </div>
  </div>
</div>

<p class="text-muted" style="font-size:13px;margin-top:8px">No secret values are shown. Configuration changes require environment variable updates.</p>
