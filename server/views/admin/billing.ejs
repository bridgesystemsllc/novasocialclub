<div class="page-header">
  <h1>Billing</h1>
</div>

<div class="kpi-grid" style="grid-template-columns:repeat(4,1fr)">
  <a href="/admin/billing?status=active" class="kpi-card">
    <span class="kpi-num"><%= counts.active %></span>
    <span class="kpi-label">Active</span>
  </a>
  <a href="/admin/billing?status=past_due" class="kpi-card">
    <span class="kpi-num"><%= counts.past_due %></span>
    <span class="kpi-label">Past due</span>
  </a>
  <a href="/admin/billing?status=canceled" class="kpi-card">
    <span class="kpi-num"><%= counts.canceled %></span>
    <span class="kpi-label">Canceled</span>
  </a>
  <a href="/admin/billing?status=none" class="kpi-card">
    <span class="kpi-num"><%= counts.none %></span>
    <span class="kpi-label">No subscription</span>
  </a>
</div>

<form method="get" action="/admin/billing" class="filters-row">
  <input name="q" value="<%= q %>" placeholder="Search name or email">
  <select name="status">
    <option value="all" <%= status === 'all' ? 'selected' : '' %>>All statuses</option>
    <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
    <option value="past_due" <%= status === 'past_due' ? 'selected' : '' %>>Past due</option>
    <option value="canceled" <%= status === 'canceled' ? 'selected' : '' %>>Canceled</option>
    <option value="none" <%= status === 'none' ? 'selected' : '' %>>No subscription</option>
  </select>
  <select name="levelId">
    <option value="all" <%= levelId === 'all' ? 'selected' : '' %>>All levels</option>
    <% levels.forEach(function(l){ %>
    <option value="<%= l.id %>" <%= String(levelId) === String(l.id) ? 'selected' : '' %>><%= l.name %></option>
    <% }); %>
  </select>
  <button class="btn-primary">Filter</button>
</form>
<% if (rows.length === 0) { %>
<div class="empty-state">
  <h3>No subscription rows yet</h3>
  <p>Billing records will appear here once members have subscriptions.</p>
</div>
<% } else { %>
<table class="data"><thead><tr>
  <th>Name</th>
  <th>Email</th>
  <th>Level</th>
  <th>Status</th>
  <th>Period end</th>
  <th>Subscription ID</th>
  <th>Customer ID</th>
  <th>Actions</th>
</tr></thead><tbody>
<% rows.forEach(function(r){ 
  var statusClass = '';
  var statusLabel = r.subscription_status || '—';
  if (r.subscription_status === 'active' || r.subscription_status === 'trialing') statusClass = 'badge-success';
  else if (r.subscription_status === 'past_due') statusClass = 'badge-warning';
  else if (r.subscription_status === 'canceled') statusClass = 'badge-danger';
  else if (!r.subscription_status) statusClass = 'badge-muted';
%>
<tr>
  <td><a href="/admin/members/<%= r.member_id %>"><%= r.first_name %> <%= r.last_name %></a></td>
  <td><%= r.email %></td>
  <td><%= r.level_name || '—' %></td>
  <td><span class="badge <%= statusClass %>"><%= statusLabel %></span></td>
  <td><%= r.current_period_end ? new Date(r.current_period_end).toLocaleDateString() : '—' %></td>
  <td class="mono"><%= r.stripe_subscription_id ? r.stripe_subscription_id.slice(0, 20) + '…' : '—' %></td>
  <td class="mono"><%= r.stripe_customer_id ? r.stripe_customer_id.slice(0, 18) + '…' : '—' %></td>
  <td>
    <a href="/admin/members/<%= r.member_id %>">View</a>
    <% if (r.stripe_customer_id) { %>
    &nbsp;|&nbsp;<a href="https://dashboard.stripe.com/customers/<%= r.stripe_customer_id %>" target="_blank" rel="noopener">Stripe</a>
    <% } %>
  </td>
</tr>
<% }); %>
</tbody></table>
<% if (rows.length >= 200) { %>
<p style="margin-top:12px;color:#666;font-size:13px">Showing first 200 rows. Use filters to narrow results.</p>
<% } %>
<% } %>
