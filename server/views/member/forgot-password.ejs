<div class="card auth-card">
  <h1>Forgot password</h1>
  <% if (success) { %><p class="success"><%= success %></p>
  <p><a href="/member/login">Back to login</a></p>
  <% } else { %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/member/forgot-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Email<input type="email" name="email" required></label>
    <button class="btn-primary">Send reset link</button>
  </form>
  <p><a href="/member/login">Cancel</a></p>
  <% } %>
</div>
