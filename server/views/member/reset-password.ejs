<div class="card auth-card">
  <h1>Reset your password</h1>
  <% if (!valid) { %><p class="error">This link is invalid or has expired. <a href="/member/forgot-password">Request a new one</a>.</p>
  <% } else { %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/member/reset-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="token" value="<%= token %>">
    <label>New password (min 8 chars)<input type="password" name="password" minlength="8" required></label>
    <label>Confirm password<input type="password" name="confirm" minlength="8" required></label>
    <button class="btn-primary">Set password</button>
  </form>
  <% } %>
</div>
