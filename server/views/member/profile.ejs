<div class="card">
  <h1>Profile</h1>
  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-warning"><%= error %></div>
  <% } %>
  <form method="post" action="/member/profile">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label>Email (read-only)</label>
      <input type="email" value="<%= m.email %>" disabled readonly>
    </div>
    <div class="form-group">
      <label for="first_name">First name</label>
      <input type="text" id="first_name" name="first_name" value="<%= m.first_name %>" maxlength="100" required>
    </div>
    <div class="form-group">
      <label for="last_name">Last name</label>
      <input type="text" id="last_name" name="last_name" value="<%= m.last_name %>" maxlength="100" required>
    </div>
    <div class="form-group">
      <label for="phone">Phone</label>
      <input type="text" id="phone" name="phone" value="<%= m.phone || '' %>" maxlength="30">
    </div>
    <div class="form-group">
      <label for="company">Company</label>
      <input type="text" id="company" name="company" value="<%= m.company || '' %>" maxlength="200">
    </div>
    <div class="form-group">
      <label for="linkedin">LinkedIn</label>
      <input type="text" id="linkedin" name="linkedin" value="<%= m.linkedin || '' %>" maxlength="500">
    </div>
    <div class="form-group">
      <label>Level (read-only)</label>
      <input type="text" value="<%= levelLabel %>" disabled readonly>
    </div>
    <div class="form-actions">
      <a href="/member" class="btn">Cancel</a>
      <button type="submit" class="btn-primary">Save</button>
    </div>
  </form>
</div>
